{
  "id": null,
  "uid": "prometheus-extended",
  "title": "Prometheus – Extended (Docker Compose)",
  "tags": ["docker", "cadvisor", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "row",
      "title": "System Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "title": "Machine CPU Cores",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "machine_cpu_cores",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Machine Memory (GB)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "machine_memory_bytes / 1024^3",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "decgbytes", "decimals": 2 },
        "overrides": []
      }
    },
    {
      "title": "Prometheus Targets Up",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(up)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none" }
      }
    },
    {
      "type": "row",
      "title": "Container CPU / Memory / Network",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "title": "CPU Usage (per service)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2
        }
      }
    },
    {
      "title": "Memory Usage (per service)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (container_memory_usage_bytes)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 2
        }
      }
    },
    {
      "title": "Network Receive (bytes/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_network_receive_bytes_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      }
    },
    {
      "title": "Network Transmit (bytes/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_network_transmit_bytes_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" }
      }
    },
    {
      "type": "row",
      "title": "Top N Containers",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
    },
    {
      "title": "Top 5 CPU Containers",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [
        {
          "expr": "topk(5, sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" }
      }
    },
    {
      "title": "Top 5 Memory Containers",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [
        {
          "expr": "topk(5, sum by (container_label_com_docker_compose_service) (container_memory_usage_bytes))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "type": "row",
      "title": "Prometheus Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }
    },
    {
      "title": "Scrape Duration (s)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "rate(scrape_duration_seconds[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Scrape Samples",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "rate(scrape_samples_scraped[5m])",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "query": "label_values(container_cpu_usage_seconds_total, container_label_com_docker_compose_service)",
        "includeAll": true,
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  }
}
